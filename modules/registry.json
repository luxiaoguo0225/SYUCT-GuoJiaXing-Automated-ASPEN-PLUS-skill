  "validation_hooks": {
    "properties": {
      "id": "P01",
      "path": "modules/properties/check.md",
      "event": "properties_entered_or_changed",
      "return_modules": [
        "M01",
        "M09",
        "M15"
      ],
      "success_state": "CONTINUE",
      "failure_state": "RUN",
      "required_checks": [
        "PROP-SOURCES",
        "PROP-ZEROS",
        "PROP-APPLICABILITY",
        "PROP-PHYSICAL",
        "PROP-READBACK"
      ],
      "owner_module": "P00",
      "before_process_simulation": true,
      "failure_route": "PROPERTIES"
    },
    "kinetics": {
      "id": "K01",
      "path": "modules/output/kinetics-validation.md",
      "event": "kinetics_entered_or_changed",
      "prerequisite": "properties",
      "return_modules": [
        "M03",
        "M01",
        "M05",
        "M08",
        "M09",
        "M15"
      ],
      "success_state": "CONTINUE",
      "failure_state": "RUN",
      "required_checks": [
        "EARLY-PROPERTIES",
        "KIN-INPUT",
        "KIN-RATES",
        "KIN-LITERATURE",
        "KIN-INDUSTRIAL",
        "KIN-SELECTIVITY",
        "KIN-RUN"
      ],
      "owner_module": "O02"
    }
  },
  "transition_guards": {
    "PROPERTY_CHECK->RUN": "P01_CONTINUE_AND_CURRENT_SNAPSHOT_GATE",
    "INTAKE->OUTPUT": "READ_ONLY_NO_EXECUTION_NO_PROPERTY_CHANGES"
  },
  "properties": "modules/properties/index.md",
  "property_check": "modules/properties/check.md",
  "process_gate": "scripts/check_process_gate.py"
