TITLE 'Waste-heat steam generation: salt loop + 25 bar steam drum (self-built 2026-09-22)'

IN-UNITS SI TEMP=C PRES=BAR MOLE-FLOW='KMOL/HR' MASS-FLOW='KG/HR' ENTHALPY-FLO='WATT'
OUT-UNITS SI TEMP=C PRES=BAR MOLE-FLOW='KMOL/HR' MASS-FLOW='KG/HR' ENTHALPY-FLO='WATT'

DEF-STREAMS CONVEN ALL

DATABANKS 'APV140 PURE37' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' &
         / 'APV140 INORGANIC' / 'APESV140 AP-EOS' / 'NISTV140 NIST-TRC' / NOASPENPCD
PROP-SOURCES 'APV140 PURE37' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' &
         / 'APV140 INORGANIC' / 'APESV140 AP-EOS' / 'NISTV140 NIST-TRC'

COMPONENTS
    KNO3 KNO3 /
    NANO3 NANO3 /
    H2O H2O

PROPERTIES IDEAL
    PROPERTIES PENG-ROB / STEAMNBS

FLOWSHEET
    BLOCK M0101 IN=SALTMK SALTRC OUT=SALTC
    BLOCK P0101 IN=SALTC OUT=SALTCP
    BLOCK E0101 IN=SALTCP OUT=SALTH
    BLOCK E0102 IN=SALTH WFED OUT=SALTR WMIX
    BLOCK M0102 IN=SALTR OUT=SALTRC SALTPG
    BLOCK P0201 IN=BFW OUT=BFWP
    BLOCK M0201 IN=BFWP WRECP OUT=WFED
    BLOCK P0202 IN=WREC OUT=WRECP
    BLOCK T0201 IN=WMIX OUT=STEAM WLIQ
    BLOCK M0202 IN=WLIQ OUT=WREC BLOW

STREAM SALTMK
    SUBSTREAM MIXED TEMP=250. PRES=3. MASS-FLOW=260.
    MASS-FRAC KNO3 0.4 / NANO3 0.6

STREAM BFW
    SUBSTREAM MIXED TEMP=105. PRES=5. MASS-FLOW=930.
    MASS-FRAC H2O 1.

STREAM WREC
    SUBSTREAM MIXED TEMP=223. PRES=25. MASS-FLOW=4600.
    MASS-FRAC H2O 1.

BLOCK M0101 MIXER
    PARAM

BLOCK P0101 PUMP
    PARAM PRES=5.

BLOCK E0101 HEATER
    PARAM PRES=-0.8 DUTY=2160000. <kJ/hr>

BLOCK E0102 HEATX
    PARAM T-HOT=250. CALC-TYPE=DESIGN U-OPTION=PHASE F-OPTION=CONSTANT &
         CALC-METHOD=SHORTCUT PRES-HOT=-1.2 PRES-COLD=-1.6
    FEEDS HOT=SALTH COLD=WFED
    OUTLETS-HOT SALTR
    OUTLETS-COLD WMIX
    PROPERTIES IDEAL / STEAMNBS
    HOT-SIDE DP-OPTION=CONSTANT DPPARMOPT=NO
    COLD-SIDE DP-OPTION=CONSTANT DPPARMOPT=NO

BLOCK M0102 FSPLIT
    FRAC SALTPG 0.01

BLOCK P0201 PUMP
    PARAM PRES=27.
    PROPERTIES STEAMNBS

BLOCK M0201 MIXER
    PARAM
    PROPERTIES STEAMNBS

BLOCK P0202 PUMP
    PARAM PRES=26.6
    PROPERTIES STEAMNBS

BLOCK T0201 FLASH2
    PARAM PRES=25. DUTY=0.
    PROPERTIES STEAMNBS

BLOCK M0202 FSPLIT
    FRAC BLOW .00117
    PROPERTIES STEAMNBS

CONV-OPTIONS
    PARAM TEAR-VAR=NO
    WEGSTEIN MAXIT=1000
    PARAM TOL=1.E-5

TEAR SALTRC
TEAR WREC
