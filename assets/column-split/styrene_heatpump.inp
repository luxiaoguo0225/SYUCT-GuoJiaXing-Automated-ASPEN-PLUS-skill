TITLE 'Styrene Vacuum Column Split with Vapor Recompression Heat Pump'

IN-UNITS MET PRESSURE=bar TEMPERATURE=C DELTA-T=C PDROP=bar  &
        INVERSE-PRES='1/bar' SHORT-LENGTH=mm
OUT-UNITS MET PRESSURE=bar TEMPERATURE=C DELTA-T=C PDROP=bar  &
        INVERSE-PRES='1/bar' SHORT-LENGTH=mm

DEF-STREAMS CONVEN ALL

COMPONENTS
    C8H10 C8H10-4 /
    C8H8 C8H8 /
    H2 H2 /
    H2O H2O /
    CH4 CH4 /
    C6H6 C6H6 /
    C6H5CH3 C7H8 /
    C2H4 C2H4 /
    P-TER-01 C10H14O2 /
    DEB C10H14-D1 /
    PX C8H10-3 /
    ET C2H6O-2 /
    C2H6 C2H6

DATABANKS 'APV140 PURE40' / 'APV140 AQUEOUS' / 'APV140 SOLIDS'  &
         / 'APV140 INORGANIC' / 'APESV140 AP-EOS' /  &
        'NISTV140 NIST-TRC' / NOASPENPCD

PROP-SOURCES 'APV140 PURE40' / 'APV140 AQUEOUS' /  &
        'APV140 SOLIDS' / 'APV140 INORGANIC' / 'APESV140 AP-EOS' &
         / 'NISTV140 NIST-TRC'

PROPERTIES PENG-ROB

FLOWSHEET
    BLOCK C1 IN=FEED REF REB-VAP OUT=TOP-VAP BOT-LIQ
    BLOCK HP-SPLIT IN=TOP-VAP OUT=HP-VAP COND-VAP
    BLOCK SUPERH IN=HP-VAP OUT=HP-SUP
    BLOCK COMPR IN=HP-SUP OUT=HP-HOT
    BLOCK REB-HX IN=HP-HOT BOT-LIQ OUT=HP-OUT REB-OUT
    BLOCK VALVE IN=HP-OUT OUT=HP-LOW
    BLOCK E-COND IN=COND-VAP OUT=COND-OUT
    BLOCK V-COND IN=COND-OUT OUT=OFF-GAS COND-LIQ
    BLOCK MIX IN=HP-LOW COND-LIQ OUT=SPLIT-FEED
    BLOCK SPLIT IN=SPLIT-FEED OUT=REF DIST
    BLOCK V-REB IN=REB-OUT OUT=REB-VAP BOT

STREAM FEED
    SUBSTREAM MIXED TEMP=98.9763797 PRES=0.12 MOLE-FLOW=478.5364
    MOLE-FRAC C8H10 0.0002051 / C8H8 0.9984120 / P-TER-01 0.0000314 / DEB 0.0013515

STREAM REF
    SUBSTREAM MIXED TEMP=62.3176029 PRES=0.06 MOLE-FLOW=211.3053
    MOLE-FRAC C8H10 0.0002058 / C8H8 0.9996258 / DEB 0.0001686

STREAM REB-VAP
    SUBSTREAM MIXED TEMP=81.8896371 PRES=0.1 MOLE-FLOW=146.5689
    MOLE-FRAC C8H10 0.0000002 / C8H8 0.8429360 / P-TER-01 0.0000350 / DEB 0.1570290

CONV-OPTIONS
    PARAM TEAR-METHOD=BROYDEN
    WEGSTEIN MAXIT=500
    BROYDEN MAXIT=500

CONVERGENCE CV BROYDEN
    TEAR REF
    TEAR REB-VAP

BLOCK HP-SPLIT FSPLIT
    MOLE-FLOW HP-VAP 149.

BLOCK COMPR COMPR
    PARAM TYPE=ASME-POLYTROP PRATIO=3.5 PEFF=0.8 MEFF=0.95  &
        SB-MAXIT=30 SB-TOL=0.0001

BLOCK SUPERH HEATER
    PARAM TEMP=80. PRES=0.0605

BLOCK REB-HX HEATX
    PARAM VFRAC-HOT=0. CALC-TYPE=DESIGN U-OPTION=PHASE  &
        F-OPTION=CONSTANT CALC-METHOD=SHORTCUT
    FEEDS HOT=HP-HOT COLD=BOT-LIQ
    OUTLETS-HOT HP-OUT
    OUTLETS-COLD REB-OUT
    HOT-SIDE DP-OPTION=CONSTANT DPPARMOPT=NO
    COLD-SIDE DP-OPTION=CONSTANT DPPARMOPT=NO
    TQ-PARAM CURVE=YES

BLOCK VALVE VALVE
    PARAM P-OUT=0.0605

BLOCK E-COND HEATER
    PARAM VFRAC=0.0 PRES=0.0605

BLOCK V-COND FLASH2
    PARAM DUTY=0.0 PRES=0.0605

BLOCK MIX MIXER

BLOCK SPLIT FSPLIT
    MOLE-FLOW DIST 477.

BLOCK V-REB FLASH2
    PARAM DUTY=0.0 PRES=0.1

BLOCK C1 RADFRAC
    PARAM NSTAGE=80 ALGORITHM=STANDARD MAXOL=100
    COL-CONFIG CONDENSER=NONE REBOILER=NONE
    FEEDS FEED 40 / REF 1 ON-STAGE / REB-VAP 80 ON-STAGE
    PRODUCTS TOP-VAP 1 V / BOT-LIQ 80 L
    P-SPEC 1 0.0605
    COL-SPECS DP-STAGE=0.0005

STREAM-REPOR MOLEFLOW
